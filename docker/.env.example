# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Django superuser (criado automaticamente pelo entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=your-superuser-password

# PostgreSQL (admin de bootstrap - usado apenas para criar DB/user da app)
DB_NAME=gestao_denuncias
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=postgres
DB_PORT=5432

# App DB user - usuário separado que o Django usa (não-admin)
APP_DB_USER=gestao_app
APP_DB_PASSWORD=your-app-user-password

# Redis
REDIS_URL=redis://cache:6379/0

# Nginx
NGINX_PORT=80

# Host directory mappings (PATHS ABSOLUTOS no host).
# Estes diretórios são criados automaticamente pelo scripts/docker_dev.sh se não existirem.
POSTGRES_DATA_DIR=/srv/gestao-denuncias/data/postgres
REDIS_DATA_DIR=/srv/gestao-denuncias/data/redis
STATIC_FILES_DIR=/srv/gestao-denuncias/staticfiles
MEDIA_FILES_DIR=/srv/gestao-denuncias/media
